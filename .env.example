# Copy to .env and fill in. Never commit .env.

# Snowflake
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=          # e.g. abc12345.us-west-2
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PROJECTDB
SNOWFLAKE_SCHEMA=PROJECTSCHEMA
SNOWFLAKE_ROLE=

# PostgreSQL (defaults match the UCSD Rady rsm-docker container)
PG_HOST=127.0.0.1
PG_PORT=8765
PG_DATABASE=rsm-docker
PG_USER=jovyan
PG_PASSWORD=postgres

# Folder with the raw input files (see data/README.md)
DATA_DIR=./data

# Optional: fully-qualified NOAA Marketplace objects (auto-discovered if blank)
NOAA_STATIONS_TABLE=
NOAA_TIMESERIES_TABLE=
